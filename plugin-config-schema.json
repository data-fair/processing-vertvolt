{
  "$id": "https://github.com/data-fair/processing-vertvolt/plugin-config",
  "type": "object",
  "title": "PluginConfig",
  "required": ["protocol", "host", "username"],
  "properties": {
    "protocol": {
      "type": "string",
      "title": "Protocole",
      "enum": ["ftp", "sftp"],
      "default": "ftp"
    },
    "host": {
      "type": "string",
      "title": "Hôte"
    },
    "port": {
      "type": "number",
      "title": "Port",
      "description": "Par défaut 21 pour FTP, 22 pour SFTP"
    },
    "username": {
      "type": "string",
      "title": "Utilisateur",
      "layout": {
        "props": {
          "autocomplete": "suppress"
        }
      }
    },
    "password": {
      "type": "string",
      "title": "Mot de passe",
      "layout": {
        "props": {
          "type": "password",
          "autocomplete": "suppress"
        }
      }
    },
    "sshKey": {
      "type": "string",
      "title": "Clé SSH privée (SFTP uniquement)",
      "layout": "textarea"
    },
    "folder": {
      "type": "string",
      "title": "Répertoire contenant les fichiers",
      "default": "/ftp/Vertvolt"
    }
  }
}
